# =============================================================================
#  ВКР — экспериментальный стенд по гибридному семантическому поиску
#  В репозитории трекаем только исходники: hybrid_search/, scripts/, tests/,
#  pyproject.toml, README.md. Всё, что генерируется, кэшируется или
#  привязано к конкретной машине, исключается.
# =============================================================================

# --- Python байткод и сборка -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg

# --- Виртуальные окружения ---------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Кэши инструментов и ML --------------------------------------------------
.hf_cache/
.cache/
.mplconfig/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.nox/

# --- Эксперименты и большие данные (регенерируются) --------------------------
data/**
artifacts/**
checkpoints/
logs/
*.log
*.log.*
*.prep.log

# --- MLflow / W&B локальные стор ---------------------------------------------
mlruns/
mlartifacts/
wandb/

# --- Документация (фигуры регенерируются скриптом plot_experiment_results.py)
docs/

# --- Jupyter Notebooks -------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints/

# --- Среды разработки --------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*~
.project
.pydevproject

# --- Операционные системы ----------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Локальные секреты и конфиги ---------------------------------------------
.env
.env.local
.env.*.local
*.local
*.pem
*.key

# --- Сериализованные модели и большие чекпойнты ------------------------------
# (хранятся в artifacts/, но на всякий случай)
*.pt
*.bin
*.safetensors
*.onnx

# --- Артефакты HPC -----------------------------------------------------------
slurm-*.out
*.pid
core.*


