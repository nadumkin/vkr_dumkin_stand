# =============================================================================
#  ВКР — экспериментальный стенд по гибридному семантическому поиску
#  В репозитории трекаем только исходники: hybrid_search/, scripts/, tests/,
#  pyproject.toml, README.md. Всё, что генерируется, кэшируется или
#  привязано к конкретной машине, исключается.
# =============================================================================

# --- Python байткод и сборка -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg

# --- Виртуальные окружения ---------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Кэши инструментов и ML --------------------------------------------------
.hf_cache/
.cache/
.mplconfig/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.nox/

