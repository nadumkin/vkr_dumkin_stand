data/
artifacts/
checkpoints/
logs/
*.log
*.log.*
*.prep.log

# --- MLflow / W&B локальные стор ---------------------------------------------
mlruns/
mlartifacts/
wandb/

# --- Документация (фигуры регенерируются скриптом plot_experiment_results.py)
docs/

